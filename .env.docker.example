FIXER_IMAGE=ghcr.io/ns2kracy/fixer:latest
FIXER_MEDIA_PATH=/absolute/path/to/media
FIXER_BIND_IP=127.0.0.1
FIXER_PORT=3000
FIXER_SERVER__ALLOWED_ORIGINS=http://127.0.0.1:3000
FIXER_SERVER__HTTPS_TERMINATION=false
FIXER_LOGGING__FILTER=fixer_server=info,tower_http=info
FIXER_LOGGING__FORMAT=json

# Provider credentials belong in the ignored .env.secrets file, not here.
# Example: TMDB_API_TOKEN=replace-with-a-real-secret
