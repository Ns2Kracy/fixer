{
  "name": "fixer-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fixer task workspace. Solid 2 is pinned to 2.0.0-rc.3 because no stable 2.x release was published when Task 23 was implemented.",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": "11.22.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite",
    "routes:generate": "vite build --mode route-generation",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.3",
    "@tanstack/solid-query": "6.0.0-rc.0",
    "@tanstack/solid-router": "2.0.0-rc.3",
    "solid-js": "2.0.0-rc.3"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.34",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.35",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
